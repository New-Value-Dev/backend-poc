DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_platform
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# ── Storage ──
STORAGE_ROOT=../storage

# ── Auth (JWT) ──
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:3000
# dev 는 ["mock"], Google 크리덴셜 준비되면 ["mock","google"]
AUTH_PROVIDERS=["mock"]

# ── Google OAuth (실제 값은 .env 에만, 커밋 금지) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── LLM (GPT) ──
# 키가 비어 있으면 proofread 는 MockLLMProvider(규칙 기반)로 자동 폴백
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# gpt-5.x 계열 추론 강도(minimal|low|medium|high)
# OPENAI_REASONING_EFFORT=low
LLM_PROVIDER=auto
# 교정에서 지적할 오류 유형(JSON 배열). 생략하면 ["spelling","spacing"]
# PROOFREAD_CATEGORIES=["spelling","spacing","grammar","expression"]
# 병렬 처리 시 배치 호출 동시 실행 수
PROOFREAD_BATCH_CONCURRENCY=4

# ── Web Push (VAPID) ──
# 키 생성: python -c "
#   from py_vapid import Vapid01; from py_vapid.utils import b64urlencode
#   from cryptography.hazmat.primitives import serialization
#   v = Vapid01(); v.generate_keys()
#   pub = v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
#   priv = v.private_key.private_numbers().private_value.to_bytes(32, 'big')
#   print('PUBLIC:', b64urlencode(pub)); print('PRIVATE:', b64urlencode(priv))
# "
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:change-me@example.com